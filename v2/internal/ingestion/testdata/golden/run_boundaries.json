{
  "spec": {
    "id": "run-001",
    "idempotency_key": "upload/request-001",
    "input_artifact_id": "blob-source-001",
    "input_fingerprint": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "kind": "INITIAL",
    "document_id": "doc-reserved-001",
    "target_generation": 1,
    "expected_active_generation": 0
  },
  "scenarios": [
    {
      "name": "success_and_redelivery",
      "operations": [
        {"kind": "start", "fence": 10},
        {"kind": "start", "fence": 10},
        {"kind": "advance", "fence": 10, "checkpoint": "TEXT_EXTRACTED"},
        {"kind": "advance", "fence": 10, "checkpoint": "TEXT_EXTRACTED"},
        {"kind": "advance", "fence": 10, "checkpoint": "DEDUP_CHECKED"},
        {"kind": "advance", "fence": 10, "checkpoint": "CHUNKS_STAGED"},
        {"kind": "advance", "fence": 10, "checkpoint": "INDEX_STAGED"},
        {"kind": "advance", "fence": 10, "checkpoint": "VERIFIED"},
        {"kind": "commit", "fence": 10}
      ],
      "want": {"status": "SUCCEEDED", "checkpoint": "VERIFIED", "revision": 8, "attempt": 1, "fence": 10}
    },
    {
      "name": "text_duplicate_is_outcome_not_failure",
      "operations": [
        {"kind": "start", "fence": 20},
        {"kind": "advance", "fence": 20, "checkpoint": "TEXT_EXTRACTED"},
        {"kind": "duplicate_text", "fence": 20}
      ],
      "want": {"status": "DUPLICATE", "checkpoint": "TEXT_EXTRACTED", "revision": 4, "attempt": 1, "fence": 20}
    },
    {
      "name": "queued_cancel_is_terminal_before_execution",
      "operations": [{"kind": "request_cancel"}],
      "want": {"status": "CANCELLED", "checkpoint": "ACCEPTED", "revision": 2, "attempt": 0, "fence": 0}
    },
    {
      "name": "running_cancel_is_cooperative",
      "operations": [
        {"kind": "start", "fence": 30},
        {"kind": "request_cancel"},
        {"kind": "ack_cancel", "fence": 30}
      ],
      "want": {"status": "CANCELLED", "checkpoint": "ACCEPTED", "revision": 4, "attempt": 1, "fence": 30}
    },
    {
      "name": "failure_is_terminal_and_preserves_checkpoint",
      "operations": [
        {"kind": "start", "fence": 40},
        {"kind": "advance", "fence": 40, "checkpoint": "TEXT_EXTRACTED"},
        {"kind": "fail", "fence": 40}
      ],
      "want": {"status": "FAILED", "checkpoint": "TEXT_EXTRACTED", "revision": 4, "attempt": 1, "fence": 40}
    },
    {
      "name": "strong_kill_recovery_fences_old_worker",
      "operations": [
        {"kind": "start", "fence": 50},
        {"kind": "advance", "fence": 50, "checkpoint": "TEXT_EXTRACTED"},
        {"kind": "start", "fence": 51},
        {"kind": "advance", "fence": 50, "checkpoint": "DEDUP_CHECKED", "want_error": "stale execution fence"},
        {"kind": "advance", "fence": 51, "checkpoint": "DEDUP_CHECKED"}
      ],
      "want": {"status": "RUNNING", "checkpoint": "DEDUP_CHECKED", "revision": 5, "attempt": 2, "fence": 51}
    }
  ]
}
