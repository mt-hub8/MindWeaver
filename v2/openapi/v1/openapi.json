{
  "openapi": "3.1.0",
  "info": {
    "title": "MindWeaver Local API",
    "version": "1.0.0-draft.1",
    "summary": "Versioned local-first API contract for the MindWeaver Go rewrite.",
    "description": "All browser endpoints are under /api/v1. Error responses use one problem-details model. Mutating operations require CSRF and an idempotency key; mutable resources use strong ETags."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    { "url": "/", "description": "Same-origin local server" }
  ],
  "security": [
    { "sessionCookie": [] }
  ],
  "tags": [
    { "name": "Session" },
    { "name": "Providers" },
    { "name": "Conversations" },
    { "name": "Inference" },
    { "name": "Answers" }
  ],
  "paths": {
    "/api/v1/bootstrap/session": {
      "post": {
        "operationId": "bootstrapSession",
        "tags": ["Session"],
        "summary": "Exchange a one-time bootstrap secret for a browser session",
        "security": [],
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BootstrapSessionRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created. The bootstrap secret is consumed even when the response is lost.",
            "headers": {
              "Set-Cookie": { "schema": { "type": "string" }, "description": "HttpOnly session cookie; never readable by browser JavaScript." },
              "Cache-Control": { "schema": { "type": "string", "const": "no-store" } },
              "Idempotency-Replayed": { "$ref": "#/components/headers/IdempotencyReplayed" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BrowserSession" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/v1/session": {
      "get": {
        "operationId": "getSession",
        "tags": ["Session"],
        "responses": {
          "200": {
            "description": "Current session metadata",
            "headers": { "Cache-Control": { "schema": { "type": "string", "const": "no-store" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BrowserSession" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "operationId": "revokeSession",
        "tags": ["Session"],
        "parameters": [
          { "$ref": "#/components/parameters/CSRFToken" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "204": { "description": "Session revoked" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/providers/capabilities": {
      "get": {
        "operationId": "listProviderCapabilities",
        "tags": ["Providers"],
        "summary": "List sanitized provider and model capabilities",
        "responses": {
          "200": {
            "description": "Provider capability snapshots; credentials and secret configuration are never returned.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["items"],
                  "properties": {
                    "items": { "type": "array", "items": { "$ref": "#/components/schemas/ProviderCapability" } }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/conversations": {
      "get": {
        "operationId": "listConversations",
        "tags": ["Conversations"],
        "parameters": [
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": {
            "description": "Conversation page",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConversationPage" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "operationId": "createConversation",
        "tags": ["Conversations"],
        "parameters": [
          { "$ref": "#/components/parameters/CSRFToken" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateConversationRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Conversation created",
            "headers": {
              "Location": { "schema": { "type": "string", "format": "uri-reference" } },
              "ETag": { "$ref": "#/components/headers/ETag" },
              "Idempotency-Replayed": { "$ref": "#/components/headers/IdempotencyReplayed" }
            },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Conversation" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/conversations/{conversationId}": {
      "parameters": [
        { "$ref": "#/components/parameters/ConversationID" }
      ],
      "get": {
        "operationId": "getConversation",
        "tags": ["Conversations"],
        "parameters": [
          { "$ref": "#/components/parameters/IfNoneMatch" }
        ],
        "responses": {
          "200": {
            "description": "Conversation",
            "headers": { "ETag": { "$ref": "#/components/headers/ETag" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Conversation" } } }
          },
          "304": { "description": "Not modified" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "operationId": "updateConversation",
        "tags": ["Conversations"],
        "parameters": [
          { "$ref": "#/components/parameters/CSRFToken" },
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/IfMatch" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/merge-patch+json": { "schema": { "$ref": "#/components/schemas/UpdateConversationRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Updated conversation",
            "headers": {
              "ETag": { "$ref": "#/components/headers/ETag" },
              "Idempotency-Replayed": { "$ref": "#/components/headers/IdempotencyReplayed" }
            },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Conversation" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "412": { "$ref": "#/components/responses/PreconditionFailed" },
          "428": { "$ref": "#/components/responses/PreconditionRequired" }
        }
      },
      "delete": {
        "operationId": "deleteConversation",
        "tags": ["Conversations"],
        "parameters": [
          { "$ref": "#/components/parameters/CSRFToken" },
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/IfMatch" }
        ],
        "responses": {
          "204": { "description": "Conversation deleted" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "412": { "$ref": "#/components/responses/PreconditionFailed" },
          "428": { "$ref": "#/components/responses/PreconditionRequired" }
        }
      }
    },
    "/api/v1/conversations/{conversationId}/turns": {
      "parameters": [
        { "$ref": "#/components/parameters/ConversationID" }
      ],
      "post": {
        "operationId": "createConversationTurn",
        "tags": ["Inference"],
        "summary": "Append a user turn and start one tracked inference invocation",
        "parameters": [
          { "$ref": "#/components/parameters/CSRFToken" },
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/IfMatch" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateTurnRequest" } } }
        },
        "responses": {
          "202": {
            "description": "Turn accepted and invocation created",
            "headers": {
              "Location": { "schema": { "type": "string", "format": "uri-reference" } },
              "ETag": { "$ref": "#/components/headers/ETag" },
              "Idempotency-Replayed": { "$ref": "#/components/headers/IdempotencyReplayed" }
            },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Invocation" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "412": { "$ref": "#/components/responses/PreconditionFailed" },
          "428": { "$ref": "#/components/responses/PreconditionRequired" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/v1/inference-invocations/{invocationId}": {
      "parameters": [
        { "$ref": "#/components/parameters/InvocationID" }
      ],
      "get": {
        "operationId": "getInferenceInvocation",
        "tags": ["Inference"],
        "parameters": [
          { "$ref": "#/components/parameters/IfNoneMatch" }
        ],
        "responses": {
          "200": {
            "description": "Invocation snapshot",
            "headers": { "ETag": { "$ref": "#/components/headers/ETag" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Invocation" } } }
          },
          "304": { "description": "Not modified" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/inference-invocations/{invocationId}/cancel": {
      "parameters": [
        { "$ref": "#/components/parameters/InvocationID" }
      ],
      "post": {
        "operationId": "cancelInferenceInvocation",
        "tags": ["Inference"],
        "parameters": [
          { "$ref": "#/components/parameters/CSRFToken" },
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/IfMatch" }
        ],
        "responses": {
          "202": {
            "description": "Cancellation requested or already terminal",
            "headers": {
              "ETag": { "$ref": "#/components/headers/ETag" },
              "Idempotency-Replayed": { "$ref": "#/components/headers/IdempotencyReplayed" }
            },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Invocation" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "412": { "$ref": "#/components/responses/PreconditionFailed" },
          "428": { "$ref": "#/components/responses/PreconditionRequired" }
        }
      }
    },
    "/api/v1/inference-invocations/{invocationId}/events": {
      "parameters": [
        { "$ref": "#/components/parameters/InvocationID" }
      ],
      "get": {
        "operationId": "streamInferenceEvents",
        "tags": ["Inference"],
        "summary": "Resumeable server-sent event stream",
        "description": "Event ids are opaque, monotonically ordered within one invocation, and retained long enough for bounded reconnection. Unknown or expired Last-Event-ID values return 409 rather than silently skipping data.",
        "parameters": [
          { "$ref": "#/components/parameters/LastEventID" }
        ],
        "responses": {
          "200": {
            "description": "SSE stream. Each data field contains one JSON InferenceEvent.",
            "headers": {
              "Cache-Control": { "schema": { "type": "string", "const": "no-cache, no-transform" } },
              "X-Accel-Buffering": { "schema": { "type": "string", "const": "no" } }
            },
            "content": {
              "text/event-stream": {
                "schema": { "type": "string" },
                "x-sse-data-schema": { "$ref": "#/components/schemas/InferenceEvent" },
                "x-sse-events": ["snapshot", "state", "delta", "answer", "error", "heartbeat"]
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/answers/{answerId}": {
      "parameters": [
        { "$ref": "#/components/parameters/AnswerID" }
      ],
      "get": {
        "operationId": "getAnswer",
        "tags": ["Answers"],
        "parameters": [
          { "$ref": "#/components/parameters/IfNoneMatch" }
        ],
        "responses": {
          "200": {
            "description": "Final answer or enforced refusal",
            "headers": { "ETag": { "$ref": "#/components/headers/ETag" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Answer" } } }
          },
          "304": { "description": "Not modified" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mw_session",
        "description": "Opaque, rotated, HttpOnly session id. It is never accepted in a URL or Authorization header."
      }
    },
    "parameters": {
      "CSRFToken": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "minLength": 32, "maxLength": 256 },
        "description": "Session-bound CSRF token. Required in addition to same-origin validation."
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
        "description": "Scoped to session + operation. Reuse with a different canonical request hash fails with IDEMPOTENCY_KEY_REUSED."
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "pattern": "^\"[^\"]+\"$" },
        "description": "Strong ETag required for mutations of existing resources."
      },
      "IfNoneMatch": {
        "name": "If-None-Match",
        "in": "header",
        "required": false,
        "schema": { "type": "string" }
      },
      "LastEventID": {
        "name": "Last-Event-ID",
        "in": "header",
        "required": false,
        "schema": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "schema": { "type": "string", "maxLength": 512 }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 30 }
      },
      "ConversationID": {
        "name": "conversationId",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Identifier" }
      },
      "InvocationID": {
        "name": "invocationId",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Identifier" }
      },
      "AnswerID": {
        "name": "answerId",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Identifier" }
      }
    },
    "headers": {
      "ETag": {
        "schema": { "type": "string", "pattern": "^\"[^\"]+\"$" },
        "description": "Strong entity tag over the client-visible representation."
      },
      "IdempotencyReplayed": {
        "schema": { "type": "boolean" },
        "description": "True when the original stored response is replayed."
      }
    },
    "responses": {
      "BadRequest": { "$ref": "#/components/responses/Problem400" },
      "Unauthorized": { "$ref": "#/components/responses/Problem401" },
      "Forbidden": { "$ref": "#/components/responses/Problem403" },
      "NotFound": { "$ref": "#/components/responses/Problem404" },
      "Conflict": { "$ref": "#/components/responses/Problem409" },
      "PreconditionFailed": { "$ref": "#/components/responses/Problem412" },
      "PreconditionRequired": { "$ref": "#/components/responses/Problem428" },
      "TooManyRequests": {
        "description": "Rate limited",
        "headers": { "Retry-After": { "schema": { "type": "integer", "minimum": 1 } } },
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "ServiceUnavailable": {
        "description": "Provider or service temporarily unavailable",
        "headers": { "Retry-After": { "schema": { "type": "integer", "minimum": 1 } } },
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Problem400": { "description": "Invalid request", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Problem401": { "description": "Missing or expired session", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Problem403": { "description": "Origin, CSRF, or policy check failed", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Problem404": { "description": "Resource not found", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Problem409": { "description": "State or idempotency conflict", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Problem412": { "description": "ETag does not match current representation", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Problem428": { "description": "If-Match is required", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
    },
    "schemas": {
      "Identifier": {
        "type": "string",
        "minLength": 8,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "BootstrapSessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bootstrapToken"],
        "properties": {
          "bootstrapToken": { "type": "string", "minLength": 32, "maxLength": 512, "writeOnly": true }
        }
      },
      "BrowserSession": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessionId", "csrfToken", "createdAt", "idleExpiresAt", "absoluteExpiresAt"],
        "properties": {
          "sessionId": { "$ref": "#/components/schemas/Identifier" },
          "csrfToken": { "type": "string", "minLength": 32, "maxLength": 256, "readOnly": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "idleExpiresAt": { "type": "string", "format": "date-time" },
          "absoluteExpiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "ProviderCapability": {
        "type": "object",
        "additionalProperties": false,
        "required": ["providerId", "modelId", "operations", "features"],
        "properties": {
          "providerId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "modelId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "displayName": { "type": "string", "maxLength": 160 },
          "operations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["chat", "embedding"] } },
          "features": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["stream", "toolUse", "jsonMode", "usage", "cancel"] } },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "maxInputTokens": { "type": "integer", "minimum": 1 },
              "maxOutputTokens": { "type": "integer", "minimum": 1 },
              "embeddingDimensions": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true }
            }
          }
        }
      },
      "CreateConversationRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      },
      "UpdateConversationRequest": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      },
      "Conversation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "version", "createdAt", "updatedAt"],
        "properties": {
          "id": { "$ref": "#/components/schemas/Identifier" },
          "title": { "type": "string" },
          "version": { "type": "integer", "minimum": 1 },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ConversationPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Conversation" } },
          "nextCursor": { "type": ["string", "null"] }
        }
      },
      "CreateTurnRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content", "answerMode"],
        "properties": {
          "content": { "type": "string", "minLength": 1, "maxLength": 100000 },
          "answerMode": { "type": "string", "enum": ["strict", "explore"] },
          "providerId": { "type": "string", "maxLength": 64 },
          "modelId": { "type": "string", "maxLength": 128 }
        }
      },
      "Invocation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "conversationId", "status", "version", "createdAt", "updatedAt"],
        "properties": {
          "id": { "$ref": "#/components/schemas/Identifier" },
          "conversationId": { "$ref": "#/components/schemas/Identifier" },
          "status": { "type": "string", "enum": ["created", "policy_check", "queued", "running", "streaming", "succeeded", "refused", "cancelled", "failed"] },
          "version": { "type": "integer", "minimum": 1 },
          "providerId": { "type": "string" },
          "modelId": { "type": "string" },
          "answerId": { "oneOf": [{ "$ref": "#/components/schemas/Identifier" }, { "type": "null" }] },
          "failure": { "oneOf": [{ "$ref": "#/components/schemas/InvocationFailure" }, { "type": "null" }] },
          "usage": { "oneOf": [{ "$ref": "#/components/schemas/Usage" }, { "type": "null" }] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "InvocationFailure": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class", "retryable"],
        "properties": {
          "class": { "type": "string", "enum": ["policy", "capability", "authentication", "rate_limit", "timeout", "transport", "provider", "invalid_response", "cancelled", "internal"] },
          "retryable": { "type": "boolean" },
          "safeMessage": { "type": "string", "maxLength": 500 }
        }
      },
      "Usage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inputTokens": { "type": "integer", "minimum": 0 },
          "outputTokens": { "type": "integer", "minimum": 0 },
          "totalTokens": { "type": "integer", "minimum": 0 }
        }
      },
      "InferenceEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "invocationId", "type", "occurredAt"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "invocationId": { "$ref": "#/components/schemas/Identifier" },
          "type": { "type": "string", "enum": ["snapshot", "state", "delta", "answer", "error", "heartbeat"] },
          "occurredAt": { "type": "string", "format": "date-time" },
          "payload": { "type": "object", "additionalProperties": true }
        }
      },
      "Answer": {
        "type": "object",
        "description": "A protocol-enforced result. Strict answered results contain at least one citation validated against the immutable AnswerContext used for generation; refusals contain no draft answer.",
        "additionalProperties": false,
        "required": ["id", "invocationId", "mode", "disposition", "citations", "createdAt"],
        "properties": {
          "id": { "$ref": "#/components/schemas/Identifier" },
          "invocationId": { "$ref": "#/components/schemas/Identifier" },
          "mode": { "type": "string", "enum": ["strict", "explore"] },
          "disposition": { "type": "string", "enum": ["answered", "refused"] },
          "content": { "type": "string" },
          "refusal": { "oneOf": [{ "$ref": "#/components/schemas/Refusal" }, { "type": "null" }] },
          "citations": { "type": "array", "items": { "$ref": "#/components/schemas/Citation" } },
          "unverifiedClaims": { "type": "array", "items": { "type": "string" } },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "allOf": [
          {
            "if": { "properties": { "disposition": { "const": "refused" } }, "required": ["disposition"] },
            "then": { "required": ["refusal"], "properties": { "content": { "maxLength": 0 }, "citations": { "maxItems": 0 } } }
          },
          {
            "if": {
              "properties": { "mode": { "const": "strict" }, "disposition": { "const": "answered" } },
              "required": ["mode", "disposition"]
            },
            "then": {
              "required": ["content"],
              "properties": { "content": { "minLength": 1 }, "citations": { "minItems": 1 }, "unverifiedClaims": { "maxItems": 0 } }
            }
          }
        ]
      },
      "Refusal": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason", "message"],
        "properties": {
          "reason": { "type": "string", "enum": ["no_context", "insufficient_evidence", "invalid_citations", "policy_denied", "ambiguous_query"] },
          "message": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      },
      "Citation": {
        "type": "object",
        "description": "The contextId and evidenceId must resolve to the immutable AnswerContext for this answer; arbitrary document or memory references are invalid.",
        "additionalProperties": false,
        "required": ["key", "contextId", "evidenceId", "quote", "support"],
        "properties": {
          "key": { "type": "string", "pattern": "^\\[[1-9][0-9]*\\]$" },
          "contextId": { "$ref": "#/components/schemas/Identifier" },
          "evidenceId": { "$ref": "#/components/schemas/Identifier" },
          "quote": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "support": { "type": "string", "enum": ["direct", "partial"] },
          "answerSpan": { "$ref": "#/components/schemas/TextSpan" }
        }
      },
      "TextSpan": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end"],
        "properties": {
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 1 }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "title", "status", "code", "requestId", "retryable"],
        "properties": {
          "type": { "type": "string", "format": "uri-reference" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "type": "integer", "minimum": 400, "maximum": 599 },
          "detail": { "type": "string" },
          "instance": { "type": "string", "format": "uri-reference" },
          "code": {
            "type": "string",
            "enum": ["INVALID_ARGUMENT", "VALIDATION_FAILED", "UNAUTHENTICATED", "FORBIDDEN", "CSRF_FAILED", "ORIGIN_NOT_ALLOWED", "NOT_FOUND", "CONFLICT", "PRECONDITION_REQUIRED", "PRECONDITION_FAILED", "IDEMPOTENCY_KEY_REUSED", "RATE_LIMITED", "PROVIDER_UNAVAILABLE", "PROVIDER_CAPABILITY_UNSUPPORTED", "EGRESS_DENIED", "INFERENCE_FAILED", "CONTEXT_INSUFFICIENT", "CITATION_INVALID", "INTERNAL", "SERVICE_UNAVAILABLE"]
          },
          "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "retryable": { "type": "boolean" },
          "violations": { "type": "array", "items": { "$ref": "#/components/schemas/Violation" } }
        }
      },
      "Violation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "rule", "message"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 },
          "message": { "type": "string" }
        }
      }
    }
  }
}
