# Reference C implementation (fetched by scripts/fetch-ref.sh)
/ref/

# Built oracle binary and objects
/bin/
*.o
*.a

# Go build/test artifacts
*.test
*.out
# NOTE: testdata/fuzz/ is deliberately NOT ignored — `go test -fuzz` writes
# failing inputs there and they are committed as regression seeds. The fuzzing
# cache (generated corpus) lives under $GOCACHE/fuzz, outside the repo.
/.claude/
